# Telegram бот
FEEDBACK_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI (Whisper — транскрипция голоса)
OPENAI_API_KEY=sk-...

# Anthropic (Claude — анализ сообщений)
ANTHROPIC_API_KEY=sk-ant-...

# Google Sheets (тот же credentials.json что и у финансового бота)
GOOGLE_CREDENTIALS_FILE=credentials.json
FEEDBACK_SPREADSHEET_ID=your_spreadsheet_id_here

# Получатели уведомлений (Telegram user ID через запятую)
# Узнать ID можно написав боту @userinfobot
OWNER_IDS=123456789

MANAGER_REST1_IDS=111111111
MANAGER_REST2_IDS=222222222
MANAGER_REST3_IDS=333333333

CHEF_REST1_IDS=444444444
CHEF_REST2_IDS=555555555
CHEF_REST3_IDS=666666666

TECHDIR_IDS=777777777

# Пульт керівника (Telegram Mini App) — див. WEBAPP_SETUP.md
WEBAPP_ENABLED=1          # 1 = піднімати дашборд (типово); 0 = вимкнути
WEBAPP_HOST=127.0.0.1     # слухати лише локально (назовні — через Cloudflare Tunnel)
WEBAPP_PORT=8081
WEBAPP_URL=               # публічний https-URL тунелю; порожньо = кнопки в меню немає
